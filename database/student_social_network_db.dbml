// =============================================================================
// STUDENT SOCIAL NETWORK - DATABASE MODEL (DBML) - AUTH SCHEMA 0E
// Trạng thái vật lý đích: OTP, social conflict, link method và reauthentication.
// - Đăng ký local chỉ tạo pending_registrations; chưa tạo users trước xác minh.
// - OTP hợp lệ mới tạo users và user_profiles trong cùng transaction.
// - Google/Facebook được lưu tại user_auth_providers và ánh xạ về cùng users.id.
// - password_hash được phép NULL với tài khoản chỉ dùng social.
// - Mọi phương thức đã liên kết đều đăng nhập vào cùng tài khoản nội bộ.
// =============================================================================

Project student_social_network {
  database_type: "MySQL"
  Note: "Mô hình DBML đồng bộ với database/student_social_network_db.sql. Auth dùng VARCHAR + CHECK trong SQL và Java enum trong source; không dùng bảng auth_challenges tổng quát."
}

// =============================================================================
// ENUM
// =============================================================================

Enum post_status {
  PUBLISHED
  HIDDEN
  DELETED
}

Enum post_media_mime_type {
  "image/jpeg"
  "image/png"
  "image/webp"
}

Enum comment_status {
  PUBLISHED
  DELETED
}

Enum report_reason {
  SPAM
  HARASSMENT
  HARMFUL_CONTENT
  VIOLENCE
  MISINFORMATION
  INAPPROPRIATE
  OTHER
}

Enum report_status {
  PENDING
  RESOLVED
  REJECTED
}

Enum admin_action_type {
  BLOCK_USER
  UNBLOCK_USER
  HIDE_POST
  RESTORE_POST
  RESOLVE_REPORT
  REJECT_REPORT
}

Enum admin_target_type {
  USER
  POST
  REPORT
}

// =============================================================================
// 1. TÀI KHOẢN VÀ HỒ SƠ
// =============================================================================


Table pending_registrations {
  id bigint [pk, increment, not null]
  registration_type varchar(16) [not null, note: "Java enum; SQL CHECK EMAIL hoặc PHONE."]
  identifier_normalized varchar(255) [note: "PENDING/COMPLETED giữ định danh chuẩn hóa; CANCELLED/EXPIRED xóa ngay."]
  active_identifier_key varchar(272) [unique, note: "PENDING = registration_type + ':' + identifier; terminal = NULL."]
  password_hash varchar(255) [note: "BCrypt; bắt buộc khi PENDING và xóa ngay khi terminal."]
  flow_token_hash char(64) [unique, note: "HMAC-SHA-256 lookup hash; giữ tối đa 7 ngày khi terminal, raw token không được lưu; cleanup được phép đặt NULL."]
  otp_hash char(64) [note: "HMAC-SHA-256 với secret riêng; xóa ngay khi terminal."]
  otp_version int [not null, default: 1]
  otp_expires_at datetime(6) [not null]
  failed_attempts tinyint [not null, default: 0]
  resend_available_at datetime(6) [not null]
  resend_count smallint [not null, default: 0, note: "Chỉ phục vụ audit; rate limit cửa sổ giờ/IP ở application cache."]
  delivery_status varchar(16) [not null, default: 'PENDING', note: "Java enum; PENDING, SENT, FAILED hoặc UNKNOWN."]
  delivery_attempt_count smallint [not null, default: 0]
  last_delivery_attempt_at datetime(6)
  last_delivery_succeeded_at datetime(6)
  delivery_failure_code varchar(64)
  status varchar(16) [not null, default: 'PENDING', note: "Java enum; SQL CHECK vòng đời."]
  expires_at datetime(6) [not null, note: "Đăng ký tạm mặc định có hiệu lực 24 giờ."]
  completed_user_id bigint [unique, note: "FK users.id; ON DELETE SET NULL."]
  terminal_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (identifier_normalized, status, expires_at, id) [name: "idx_pending_identifier_state"]
    (status, expires_at, id) [name: "idx_pending_expiry"]
    (status, terminal_at, id) [name: "idx_pending_cleanup"]
  }

  Note: "VARCHAR + Java enum + SQL CHECK. COMPLETED giữ identifier; CANCELLED/EXPIRED xóa identifier ngay. Terminal xóa password/OTP và active key, giữ flow lookup hash tối đa 7 ngày để status/idempotency; cleanup được phép đặt hash NULL."
}

Table auth_method_link_challenges {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
  purpose varchar(16) [not null, note: "Java enum; LINK_EMAIL hoặc LINK_PHONE."]
  identifier_normalized varchar(255) [note: "Chỉ tồn tại khi PENDING."]
  active_identifier_key varchar(272) [unique, note: "PENDING = purpose + ':' + identifier; terminal = NULL."]
  active_user_purpose_key varchar(64) [unique, note: "PENDING = userId + ':' + purpose; terminal = NULL."]
  flow_token_hash char(64) [unique, note: "SHA-256 opaque token; xóa khi terminal."]
  otp_hash char(64) [note: "HMAC-SHA-256; xóa khi terminal."]
  otp_version int [not null, default: 1]
  otp_expires_at datetime(6) [not null]
  failed_attempts tinyint [not null, default: 0]
  resend_available_at datetime(6) [not null]
  resend_count smallint [not null, default: 0]
  delivery_status varchar(16) [not null, default: 'PENDING', note: "PENDING, SENT, FAILED hoặc UNKNOWN."]
  delivery_attempt_count smallint [not null, default: 0]
  last_delivery_attempt_at datetime(6)
  last_delivery_succeeded_at datetime(6)
  delivery_failure_code varchar(64)
  status varchar(16) [not null, default: 'PENDING', note: "PENDING, COMPLETED, CANCELLED hoặc EXPIRED."]
  expires_at datetime(6) [not null, note: "TTL 15 phút; resend không gia hạn."]
  terminal_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (user_id, status, expires_at, id) [name: "idx_link_user_state"]
    (status, expires_at, id) [name: "idx_link_expiry"]
    (status, terminal_at, id) [name: "idx_link_cleanup"]
  }

  Note: "Challenge link email/phone riêng, không dùng pending_registrations. Mọi terminal state xóa identifier, OTP/flow hash, active keys và delivery_failure_code; cleanup tối đa 7 ngày."
}

Table social_auth_challenges {
  id bigint [pk, increment, not null]
  conflict_token_hash char(64) [unique, note: "SHA-256 opaque conflict token; xóa khi terminal."]
  provider varchar(16) [not null, note: "Java enum; GOOGLE hoặc FACEBOOK."]
  provider_user_id varchar(255) [note: "Identity đã được Backend xác minh; xóa khi terminal."]
  provider_identity_fingerprint char(64) [not null, note: "HMAC fingerprint giữ lại cho audit; dùng secret riêng, không dùng JWT/OTP secret."]
  provider_email varchar(255)
  provider_email_verified boolean
  active_provider_key varchar(96) [unique, note: "PENDING = provider + ':' + fingerprint; terminal = NULL."]
  conflict_type varchar(64) [not null]
  pending_registration_id bigint
  conflicting_user_id bigint
  resolution_action varchar(64)
  resolved_user_id bigint
  status varchar(16) [not null, default: 'PENDING', note: "PENDING, RESOLVED, CANCELLED hoặc EXPIRED."]
  expires_at datetime(6) [not null, note: "TTL 5 phút."]
  terminal_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (pending_registration_id, status, expires_at, id) [name: "idx_social_pending_registration"]
    (conflicting_user_id, status, id) [name: "idx_social_conflicting_user"]
    (status, expires_at, id) [name: "idx_social_expiry"]
    (status, terminal_at, id) [name: "idx_social_cleanup"]
  }

  Note: "Không lưu raw provider token. Khi terminal xóa raw provider identity/email nhưng giữ HMAC fingerprint. ACTIVE_EMAIL_MATCH_UNLINKED_PROVIDER chỉ hướng dẫn login existing account hoặc account recovery, không tự link."
}

Table reauthentication_challenges {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
  token_hash char(64) [unique, note: "SHA-256 opaque token; xóa khi terminal."]
  proof_method varchar(32) [not null, note: "LOCAL_PASSWORD, GOOGLE hoặc FACEBOOK; không cần trùng target."]
  scope varchar(32) [not null, note: "Hiện tại UNLINK_AUTH_METHOD."]
  target_auth_method varchar(16) [not null, note: "EMAIL, PHONE, GOOGLE hoặc FACEBOOK."]
  active_user_scope_key varchar(96) [unique, note: "ACTIVE = userId + ':' + scope; một active challenge cho mỗi user/scope."]
  status varchar(16) [not null, default: 'ACTIVE', note: "ACTIVE, CONSUMED, CANCELLED hoặc EXPIRED."]
  expires_at datetime(6) [not null, note: "TTL 5 phút."]
  terminal_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (user_id, status, expires_at, id) [name: "idx_reauth_user_state"]
    (status, expires_at, id) [name: "idx_reauth_expiry"]
    (status, terminal_at, id) [name: "idx_reauth_cleanup"]
  }

  Note: "Challenge mới cùng user/scope phải hủy challenge ACTIVE cũ. Token vẫn bind target_auth_method và chỉ consume khi thao tác nhạy cảm thành công."
}

Table users {
  id bigint [pk, increment, not null, note: "Khóa chính."]
  email varchar(255) [unique, note: "Có thể NULL khi đăng ký bằng số điện thoại; Backend chuẩn hóa về chữ thường trước khi lưu."]
  phone_number varchar(20) [unique, note: "Có thể NULL khi đăng ký bằng email; Backend chuẩn hóa về một định dạng thống nhất trước khi lưu."]
  email_verified_at datetime(6) [note: "Thời điểm xác minh email; NULL khi chưa xác minh hoặc tài khoản chưa có email."]
  phone_verified_at datetime(6) [note: "Thời điểm xác minh số điện thoại; NULL khi chưa xác minh hoặc tài khoản chưa có số điện thoại."]
  password_hash varchar(255) [note: "Mật khẩu đã băm; NULL với tài khoản chỉ dùng social."]
  role varchar(16) [not null, default: 'USER', note: "Java enum; SQL CHECK USER hoặc ADMIN."]
  status varchar(16) [not null, default: 'ACTIVE', note: "Java enum; SQL CHECK ACTIVE hoặc BLOCKED."]
  blocked_at datetime(6) [note: "Thời điểm tài khoản bị khóa."]
  blocked_reason varchar(500) [note: "Lý do khóa tài khoản."]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: "MySQL tự cập nhật bằng ON UPDATE CURRENT_TIMESTAMP(6)."]

  Indexes {
    (status, created_at, id) [name: "idx_users_status_created_at"]
  }

  Note: "Không còn CHECK bắt buộc email/phone để hỗ trợ social-only. CHECK: password_hash chỉ tồn tại khi có email hoặc phone đã verified; verified timestamp chỉ tồn tại khi identifier tương ứng khác NULL. Invariant ít nhất một auth method được bảo vệ bằng transaction, unlink guard, integration test và audit query."
}


Table user_auth_providers {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
  provider varchar(16) [not null, note: "Java enum; SQL CHECK GOOGLE hoặc FACEBOOK."]
  provider_user_id varchar(255) [not null]
  provider_email varchar(255)
  provider_email_verified boolean
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (provider, provider_user_id) [unique, name: "uq_user_auth_provider_identity"]
    (user_id, provider) [unique, name: "uq_user_auth_provider_per_user"]
    (user_id, provider, id) [name: "idx_user_auth_providers_user"]
  }

  Note: "Mỗi Google/Facebook identity chỉ thuộc một user; mỗi user tối đa một liên kết cho từng provider. provider_email/provider_email_verified cùng NULL khi provider không trả email. Không tự động liên kết tài khoản ACTIVE chỉ do trùng email."
}

Table user_profiles {
  user_id bigint [pk, not null, note: "Khóa chính đồng thời là khóa ngoại tới users.id."]
  display_name varchar(100) [note: "NULL trong thời gian onboarding; bắt buộc để hoàn tất hồ sơ."]
  avatar_url varchar(1000) [note: "Tùy chọn; NULL khi người dùng bỏ qua ảnh đại diện."]
  avatar_public_id varchar(255)
  bio varchar(500) [note: "Tùy chọn; người dùng được phép bỏ qua."]
  date_of_birth date [note: "Có thể NULL trong quá trình onboarding; bắt buộc trước khi đánh dấu hồ sơ hoàn tất theo database hiện tại."]
  profile_completed_at datetime(6) [note: "NULL khi chưa hoàn tất; được cập nhật sau khi display_name hợp lệ và người dùng xác nhận hoàn tất."]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: "MySQL tự cập nhật bằng ON UPDATE CURRENT_TIMESTAMP(6)."]

  Note: "Một hồ sơ rỗng được tạo cùng transaction với users sau khi OTP hoặc social identity hợp lệ. CHECK trong file SQL: display_name nếu có không được rỗng; profile_completed_at chỉ có giá trị khi display_name và date_of_birth đều khác NULL. Có FULLTEXT INDEX trên display_name."
}

Table refresh_tokens {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
  token_hash char(64) [not null, unique, note: "Chỉ lưu SHA-256 hash của Refresh Token."]
  device_id varchar(100)
  device_info varchar(500)
  ip_address varchar(45)
  expires_at datetime(6) [not null]
  revoked_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (user_id, revoked_at, expires_at, id) [name: "idx_refresh_tokens_user_expiry"]
  }

  Note: "CHECK: expires_at > created_at; revoked_at phải NULL hoặc >= created_at."
}

Table password_reset_tokens {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
  delivery_channel varchar(16) [not null, note: "Java enum; SQL CHECK EMAIL hoặc SMS."]
  token_hash char(64) [not null, unique]
  expires_at datetime(6) [not null]
  used_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (user_id, used_at, expires_at, id) [name: "idx_password_reset_tokens_user_state"]
  }

  Note: "CHECK: expires_at > created_at; used_at phải NULL hoặc >= created_at."
}

// =============================================================================
// 2. QUAN HỆ THEO DÕI
// =============================================================================

Table follows {
  follower_id bigint [not null, note: "Người thực hiện Follow."]
  following_id bigint [not null, note: "Người được Follow."]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (follower_id, following_id) [pk, name: "pk_follows"]
    (following_id, created_at, follower_id) [name: "idx_follows_following_created_at"]
    (follower_id, created_at, following_id) [name: "idx_follows_follower_created_at"]
  }

  Note: "CHECK: follower_id phải khác following_id."
}

// =============================================================================
// 3. BÀI VIẾT, MEDIA VÀ HASHTAG
// =============================================================================

Table posts {
  id bigint [pk, increment, not null]
  author_id bigint [not null]
  content varchar(500)
  status post_status [not null, default: 'PUBLISHED']
  is_edited boolean [not null, default: false]
  like_count int [not null, default: 0, note: "Bộ đếm dư thừa có kiểm soát để tối ưu Feed."]
  comment_count int [not null, default: 0, note: "Bộ đếm dư thừa có kiểm soát để tối ưu Feed."]
  published_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  hidden_by bigint [note: "Admin thực hiện ẩn bài."]
  hidden_at datetime(6)
  hidden_reason varchar(500)
  deleted_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: "MySQL tự cập nhật bằng ON UPDATE CURRENT_TIMESTAMP(6)."]

  Indexes {
    (author_id, status, published_at, id) [name: "idx_posts_author_status_published"]
    (status, published_at, id) [name: "idx_posts_status_published"]
    (status, like_count, comment_count, published_at, id) [name: "idx_posts_status_engagement"]
  }

  Note: "Có FULLTEXT INDEX trên content. CHECK trạng thái HIDDEN/DELETED được định nghĩa trong file SQL."
}

Table post_media {
  id bigint [pk, increment, not null]
  post_id bigint [not null]
  media_url varchar(1000) [not null]
  storage_public_id varchar(255) [not null, unique]
  mime_type post_media_mime_type [not null]
  file_size_bytes bigint [not null]
  width_px int
  height_px int
  display_order tinyint [not null]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (post_id, display_order) [unique, name: "uq_post_media_post_order"]
  }

  Note: "CHECK: display_order từ 0 đến 3; file_size_bytes > 0."
}

Table hashtags {
  id bigint [pk, increment, not null]
  normalized_name varchar(100) [not null, unique, note: "Tên hashtag dạng chữ thường, không có ký tự #."]
  display_name varchar(100) [not null]
  post_count int [not null, default: 0]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: "MySQL tự cập nhật bằng ON UPDATE CURRENT_TIMESTAMP(6)."]

  Indexes {
    (post_count, id) [name: "idx_hashtags_post_count"]
  }

  Note: "CHECK: normalized_name không được rỗng."
}

Table post_hashtags {
  post_id bigint [not null]
  hashtag_id bigint [not null]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (post_id, hashtag_id) [pk, name: "pk_post_hashtags"]
    (hashtag_id, post_id) [name: "idx_post_hashtags_hashtag_post"]
  }
}

// =============================================================================
// 4. TƯƠNG TÁC
// =============================================================================

Table post_likes {
  user_id bigint [not null]
  post_id bigint [not null]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (user_id, post_id) [pk, name: "pk_post_likes"]
    (post_id, created_at, user_id) [name: "idx_post_likes_post_created"]
  }
}

Table comments {
  id bigint [pk, increment, not null]
  post_id bigint [not null]
  user_id bigint [not null]
  parent_comment_id bigint [note: "NULL nếu là bình luận gốc; MVP chỉ hỗ trợ trả lời tối đa một cấp."]
  content varchar(1000) [not null]
  status comment_status [not null, default: 'PUBLISHED']
  deleted_at datetime(6)
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: "MySQL tự cập nhật bằng ON UPDATE CURRENT_TIMESTAMP(6)."]

  Indexes {
    (post_id, parent_comment_id, status, created_at, id) [name: "idx_comments_post_parent_created"]
    (user_id, status, created_at, id) [name: "idx_comments_user_created"]
  }

  Note: "CHECK: content không rỗng; trạng thái DELETED phải có deleted_at."
}

Table saved_posts {
  user_id bigint [not null]
  post_id bigint [not null]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (user_id, post_id) [pk, name: "pk_saved_posts"]
    (user_id, created_at, post_id) [name: "idx_saved_posts_user_created"]
    (post_id, created_at, user_id) [name: "idx_saved_posts_post_created"]
  }
}

// =============================================================================
// 5. BÁO CÁO VÀ QUẢN TRỊ
// =============================================================================

Table reports {
  id bigint [pk, increment, not null]
  reporter_id bigint [not null]
  post_id bigint [not null]
  reason report_reason [not null]
  description varchar(1000)
  status report_status [not null, default: 'PENDING']
  resolved_by bigint [note: "Admin xử lý báo cáo."]
  resolved_at datetime(6)
  resolution_note varchar(1000)
  post_content_snapshot varchar(500)
  post_media_snapshot json
  pending_report_key varchar(100) [unique, note: "Cột sinh tự động trong MySQL, chỉ có giá trị khi status=PENDING."]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`, note: "MySQL tự cập nhật bằng ON UPDATE CURRENT_TIMESTAMP(6)."]

  Indexes {
    (status, created_at, id) [name: "idx_reports_status_created"]
    (post_id, status, created_at, id) [name: "idx_reports_post_status"]
    (reporter_id, created_at, id) [name: "idx_reports_reporter_created"]
  }

  Note: "CHECK: báo cáo đã xử lý phải có resolved_by và resolved_at."
}

Table account_status_histories {
  id bigint [pk, increment, not null]
  user_id bigint [not null]
  old_status varchar(16) [not null, note: "Java enum; SQL CHECK ACTIVE hoặc BLOCKED."]
  new_status varchar(16) [not null, note: "Java enum; SQL CHECK ACTIVE hoặc BLOCKED."]
  changed_by bigint [not null, note: "Admin thực hiện thay đổi."]
  reason varchar(500) [not null]
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (user_id, created_at, id) [name: "idx_account_status_histories_user_created"]
  }

  Note: "CHECK: old_status phải khác new_status. Trigger kiểm tra changed_by có vai trò ADMIN."
}

Table admin_actions {
  id bigint [pk, increment, not null]
  admin_id bigint [not null]
  action_type admin_action_type [not null]
  target_type admin_target_type [not null]
  target_id bigint [not null, note: "Khóa đa hình; được Service kiểm tra theo target_type."]
  note varchar(1000)
  old_data json
  new_data json
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]

  Indexes {
    (target_type, target_id, created_at, id) [name: "idx_admin_actions_target_created"]
    (admin_id, created_at, id) [name: "idx_admin_actions_admin_created"]
  }

  Note: "target_id không dùng khóa ngoại trực tiếp vì tham chiếu nhiều loại đối tượng."
}

