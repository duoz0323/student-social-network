# URL công khai của Backend; không đặt secret trong biến môi trường Vite.
VITE_API_BASE_URL=http://localhost:8080

# Thời gian chờ chung của request, tính bằng mili giây.
VITE_API_TIMEOUT_MS=15000

# Contract hiện tại truyền Refresh Token trong body nên mặc định không cần cookie.
VITE_API_WITH_CREDENTIALS=false

# Google OAuth Client ID công khai dành cho ứng dụng Web; không đặt Client Secret ở Frontend.
VITE_GOOGLE_CLIENT_ID=
